{
  "name": "@nile-squad/nile-cli",
  "version": "0.1.0",
  "description": "CLI tool for scaffolding and generating Nile backend projects",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "nile-cli": "./bin/nile-cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "format": "pnpm ultracite format",
    "lint": "pnpm ultracite lint",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "nile",
    "cli",
    "scaffolding",
    "generator"
  ],
  "author": "Hussein Kizz",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "fs-extra": "^11.0.0",
    "glob": "^11.0.0",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@types/fs-extra": "^11.0.2",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "ultracite": "5.0.36",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
