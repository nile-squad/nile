import "dotenv/config";
import { defineConfig } from "drizzle-kit";

if (!process.env.DB_URL) {
  throw new Error("DB_URL is not set");
}

export default defineConfig({
  out: "./drizzle",
  schema: ["./db/schemas/index.ts"],
  dialect: "postgresql",
  dbCredentials: {
    url: process.env.DB_URL,
  },
});

