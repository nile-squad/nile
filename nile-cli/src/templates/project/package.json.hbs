  "version": "0.0.1",
  "scripts": {
    "start": "pnpm tsx index.ts",
    "build": "pnpm format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "format": "pnpm ultracite format",
