	describe("Transaction Support", () => {
		describe("withTransaction", () => {
			it("should execute multiple operations in transaction", async () => {
				const testDb = await setupTestDb();

				// Create models
				const txUserModel = createModel({
					table: testUsers,
					dbInstance: testDb.db,
					config: { dialect: "sqlite", jsonMode: "stringify" },
				});

				const txPostModel = createModel({
					table: testPosts,
					dbInstance: testDb.db,
					config: { dialect: "sqlite", jsonMode: "stringify" },
				});

				// Use transaction to create user and post atomically
				const result = await testDb.db.transaction(async (tx: any) => {
					const txUser = createModel({
						table: testUsers,
						dbInstance: tx,
						config: { dialect: "sqlite", jsonMode: "stringify" },
					});

					const txPost = createModel({
						table: testPosts,
						dbInstance: tx,
						config: { dialect: "sqlite", jsonMode: "stringify" },
					});

					// Create user
					const userData = createTestUser({
						username: "tx_user",
						email: "tx_user@example.com",
					});
					const { data: user, error: userError } =
						await txUser.create(userData);
					if (userError || !user) {
						throw new Error(userError?.message || "Failed to create user");
					}

					// Create post
					const postData = createTestPost({
						title: "Transaction Post",
						authorId: user.id,
					});
					const { data: post, error: postError } =
						await txPost.create(postData);
					if (postError || !post) {
						throw new Error(postError?.message || "Failed to create post");
					}

					return { user, post };
				});

				// Verify both were created (check using the regular models)
				const { data: createdUser } = await txUserModel.findById(
					result.user.id,
				);
				const { data: createdPost } = await txPostModel.findById(
					result.post.id,
				);

				expect(createdUser).toBeDefined();
				expect(createdPost).toBeDefined();
				expect(createdUser?.username).toBe("tx_user");
				expect(createdPost?.title).toBe("Transaction Post");
			});

			it("should rollback on error", async () => {
				const { db } = await setupTestDb();

				let errorThrown = false;

				try {
					await db.transaction(async (tx: any) => {
						const txUserModel = createModel({
							table: testUsers,
							dbInstance: tx,
							config: { dialect: "sqlite", jsonMode: "stringify" },
						});

						const userData = createTestUser({
							username: "rollback_user",
							email: "rollback_user@example.com",
						});
						await txUserModel.create(userData);

						// Force error
						throw new Error("Simulated error");
					});
				} catch {
					errorThrown = true;
				}

				expect(errorThrown).toBe(true);

				// Verify user was NOT created (rollback worked)
				const { data: users } = await userModel.findMany({
					filters: [{ where: "username", equals: "rollback_user" }],
				});
				expect(users).toHaveLength(0);
			});

