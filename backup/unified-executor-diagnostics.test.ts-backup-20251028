import { describe, expect, it, vi, beforeEach } from 'vitest';
import { executeUnified } from '../unified-executor';
import { Ok } from '../../utils/safe-try';
import * as internalConfig from '../../internal.config';

describe('Unified Executor - Diagnostics Integration', () => {
	let logSpy: any;

	beforeEach(() => {
		logSpy = vi.spyOn(internalConfig, 'log');
	});

	it('should not log diagnostics when disabled', async () => {
		const testAction = {
			name: 'testAction',
			isProtected: false,
			handler: async (payload: any) => Ok({ result: 'success' }),
		};

		const testService = {
			name: 'testService',
			description: 'Test service',
			actions: [testAction],
		};

		const result = await executeUnified({
			serviceName: 'testService',
			actionName: 'testAction',
			payload: { test: 'data' },
			serverConfig: {
				services: [testService],
				diagnostics: {
					enabled: false,
				},
			},
			authInput: {
				headers: {} as any,
				cookies: {},
			},
			interfaceContext: {} as any,
		});

		expect(result.status).toBe(true);

		// Check that no diagnostic logs were emitted
		const diagnosticLogs = logSpy.mock.calls.filter(
			(call: any) =>
				call[0].message && call[0].message.toString().startsWith('[')
		);
		expect(diagnosticLogs.length).toBe(0);
	});

	it('should log all lifecycle stages when diagnostics enabled', async () => {
		const testAction = {
			name: 'testAction',
			isProtected: false,
			handler: async (payload: any) => Ok({ result: 'success' }),
		};

		const testService = {
			name: 'testService',
			actions: [testAction],
		};

		const result = await executeUnified({
			serviceName: 'testService',
			actionName: 'testAction',
			payload: { test: 'data' },
			serverConfig: {
				services: [testService],
				diagnostics: {
					enabled: true,
					logLevel: 'minimal',
				},
			},
			authInput: {
				headers: {},
				cookies: {},
			},
			interfaceContext: {
				type: 'rest',
			},
		});

		expect(result.status).toBe(true);

		// Verify diagnostic stages were logged
		const diagnosticCalls = logSpy.mock.calls.filter(
			(call) => call[0].atFunction === 'logDiagnostic'
		);

		expect(diagnosticCalls.length).toBeGreaterThan(0);

		// Check for key lifecycle stages
		const stages = diagnosticCalls.map((call) => call[0].data.stage);
		expect(stages).toContain('execution-start');
		expect(stages).toContain('service-action-lookup');
		expect(stages).toContain('main-handler');
		expect(stages).toContain('execution-complete');
	});

	it('should include timing data when includeTimings is enabled', async () => {
		const testAction = {
			name: 'testAction',
			isProtected: false,
			handler: async (payload: any) => {
				// Simulate some work
				await new Promise((resolve) => setTimeout(resolve, 10));
				return Ok({ result: 'success' });
			},
		};

		const testService = {
			name: 'testService',
			actions: [testAction],
		};

		const result = await executeUnified({
			serviceName: 'testService',
			actionName: 'testAction',
			payload: { test: 'data' },
			serverConfig: {
				services: [testService],
				diagnostics: {
					enabled: true,
					logLevel: 'detailed',
					includeTimings: true,
				},
			},
			authInput: {
				headers: {},
				cookies: {},
			},
			interfaceContext: {
				type: 'rest',
			},
		});

		expect(result.status).toBe(true);

		// Find main-handler stage
		const mainHandlerLog = logSpy.mock.calls.find(
			(call) =>
				call[0].atFunction === 'logDiagnostic' &&
				call[0].data.stage === 'main-handler'
		);

		expect(mainHandlerLog).toBeDefined();
		expect(mainHandlerLog![0].data.duration_ms).toBeGreaterThan(0);
	});

	it('should not include payloads by default', async () => {
		const testAction = {
			name: 'testAction',
			isProtected: false,
			handler: async (payload: any) => Ok({ result: 'success' }),
		};

		const testService = {
			name: 'testService',
			actions: [testAction],
		};

		const sensitivePayload = {
			username: 'test',
			password: 'secret123',
		};

		const result = await executeUnified({
			serviceName: 'testService',
			actionName: 'testAction',
			payload: sensitivePayload,
			serverConfig: {
				services: [testService],
				diagnostics: {
					enabled: true,
					logLevel: 'detailed',
					includePayloads: false,
				},
			},
			authInput: {
				headers: {},
				cookies: {},
			},
			interfaceContext: {
				type: 'rest',
			},
		});

		expect(result.status).toBe(true);

		// Check that payload is not included in any logs
		const diagnosticCalls = logSpy.mock.calls.filter(
			(call) => call[0].atFunction === 'logDiagnostic'
		);

		for (const call of diagnosticCalls) {
			expect(call[0].data.payload).toBeUndefined();
		}
	});

	it('should log hook execution when action has hooks', async () => {
		const beforeHookAction = {
			name: 'beforeHook',
			handler: async (payload: any) => Ok({ ...payload, transformed: true }),
		};

		const mainAction = {
			name: 'testAction',
			isProtected: false,
			hooks: {
				before: [{ name: 'beforeHook', canFail: false }],
			},
			handler: async (payload: any) => Ok({ result: payload }),
		};

		const testService = {
			name: 'testService',
			actions: [beforeHookAction, mainAction],
		};

		const result = await executeUnified({
			serviceName: 'testService',
			actionName: 'testAction',
			payload: { test: 'data' },
			serverConfig: {
				services: [testService],
				diagnostics: {
					enabled: true,
					logLevel: 'detailed',
				},
			},
			authInput: {
				headers: {},
				cookies: {},
			},
			interfaceContext: {
				type: 'rest',
			},
		});

		expect(result.status).toBe(true);

		// Check for hook-related stages
		const diagnosticCalls = logSpy.mock.calls.filter(
			(call) => call[0].atFunction === 'logDiagnostic'
		);

		const stages = diagnosticCalls.map((call) => call[0].data.stage);
		expect(stages).toContain('before-hook');
		expect(stages).toContain('action-before-hooks-complete');

		// Verify hook name is logged
		const hookLog = diagnosticCalls.find(
			(call) => call[0].data.stage === 'before-hook'
		);
		expect(hookLog![0].data.hookName).toBe('beforeHook');
	});
});
