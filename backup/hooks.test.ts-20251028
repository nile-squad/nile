import { describe, it, expect, vi } from 'vitest';
import { createHookExecutor } from './hooks';
import { Ok, safeError } from '../utils/safe-try';
import type { Action } from '../types/actions';

describe('createHookExecutor', () => {
	describe('Factory Creation', () => {
		it('should create hook executor with action map', () => {
			const actions: Action[] = [
				{
					name: 'testAction',
					handler: async () => Ok({ success: true }),
					type: 'custom',
					description: 'Test action',
					validation: {},
					meta: {},
				},
			];

			const executor = createHookExecutor(actions);

			expect(executor).toBeDefined();
			expect(executor.executeActionWithHooks).toBeInstanceOf(Function);
		});

		it('should handle empty actions array', () => {
			const executor = createHookExecutor([]);

			expect(executor).toBeDefined();
			expect(executor.executeActionWithHooks).toBeInstanceOf(Function);
		});

		it('should create action map for multiple actions', () => {
			const actions: Action[] = [
				{
					name: 'action1',
					handler: async () => Ok(1),
					type: 'custom',
					description: 'Action 1',
					validation: {},
					meta: {},
				},
				{
					name: 'action2',
					handler: async () => Ok(2),
					type: 'custom',
					description: 'Action 2',
					validation: {},
					meta: {},
				},
			];

			const executor = createHookExecutor(actions);

			expect(executor).toBeDefined();
		});
	});

	describe('Hook Validation', () => {
		it('should return error when hook action not found', async () => {
			const actions: Action[] = [
				{
					name: 'mainAction',
					handler: async () => Ok({ data: 'test' }),
					type: 'custom',
					description: 'Main action',
					validation: {},
					meta: {},
					hooks: {
						before: [{ name: 'nonExistentHook', canFail: false }],
					},
				},
			];

			const executor = createHookExecutor(actions);
			const action = actions[0];

			const result = await executor.executeActionWithHooks(action, { test: 'data' });
			
			expect(result.status).toBe(false);
			expect(result.message).toContain("Action 'mainAction' pipeline failed");
		});

		it('should validate hook exists before execution', async () => {
			const hookAction: Action = {
				name: 'validHook',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Valid hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'validHook', canFail: false }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);

			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(true);
		});
	});

	describe('executeHook - Success Scenarios', () => {
		it('should execute hook successfully and return output', async () => {
			const hookAction: Action = {
				name: 'transformData',
				handler: async (data) => Ok({ ...data, transformed: true }),
				type: 'custom',
				description: 'Transform data',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'transformData' }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				value: 42,
			});

			expect(result.status).toBe(true);
			expect(result.data).toEqual({ value: 42, transformed: true });
		});

		it('should set logEntry.passed = true on success', async () => {
			const hookAction: Action = {
				name: 'successHook',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Success hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'successHook' }],
				},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(true);
			expect(result.data.pipeline.log.before).toHaveLength(1);
			expect(result.data.pipeline.log.before[0].passed).toBe(true);
		});

		it('should include hook input/output in logEntry', async () => {
			const hookAction: Action = {
				name: 'loggedHook',
				handler: async (data) => Ok({ ...data, enriched: true }),
				type: 'custom',
				description: 'Logged hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'loggedHook' }],
				},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				original: 'data',
			});

			expect(result.status).toBe(true);
			const logEntry = result.data.pipeline.log.before[0];
			expect(logEntry.name).toBe('loggedHook');
			expect(logEntry.input).toEqual({ original: 'data' });
			expect(logEntry.output).toEqual({ original: 'data', enriched: true });
		});

		it('should pass hookState in enhanced context', async () => {
			let receivedContext: any;

			const hookAction: Action = {
				name: 'contextHook',
				handler: async (data, context) => {
					receivedContext = context;
					return Ok(data);
				},
				type: 'custom',
				description: 'Context hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'contextHook' }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			await executor.executeActionWithHooks(mainAction, { test: 'data' });

			expect(receivedContext).toBeDefined();
			expect(receivedContext.hookState).toBeDefined();
			expect(receivedContext.hookState).toEqual({});
		});

		it('should merge original context with hookState', async () => {
			let receivedContext: any;

			const hookAction: Action = {
				name: 'mergeContextHook',
				handler: async (data, context) => {
					receivedContext = context;
					return Ok(data);
				},
				type: 'custom',
				description: 'Merge context hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'mergeContextHook' }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			await executor.executeActionWithHooks(
				mainAction,
				{ test: 'data' },
				{ userId: 'user123' }
			);

			expect(receivedContext.userId).toBe('user123');
			expect(receivedContext.hookState).toBeDefined();
		});
	});

	describe('executeHook - Failure (canFail: false)', () => {
		it('should stop pipeline when hook returns error', async () => {
			const hookAction: Action = {
				name: 'failingHook',
				handler: async () => safeError('Hook failed', 'hook-error'),
				type: 'custom',
				description: 'Failing hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: vi.fn(async (data) => Ok(data)),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'failingHook' }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(false);
			expect(result.message).toBe('Hook failed');
			expect(mainAction.handler).not.toHaveBeenCalled();
		});

		it('should set logEntry.passed = false on failure', async () => {
			const hookAction: Action = {
				name: 'failHook',
				handler: async () => safeError('Failed', 'error-id'),
				type: 'custom',
				description: 'Fail hook',
				validation: {},
				meta: {},
			};

			const trackingAction: Action = {
				name: 'trackingHook',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Tracking hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'trackingHook' }, { name: 'failHook' }],
				},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([
				hookAction,
				trackingAction,
				mainAction,
			]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(false);
		});

		it('should return safeError when hook throws error', async () => {
			const hookAction: Action = {
				name: 'throwingHook',
				handler: async () => {
					throw new Error('Hook threw error');
				},
				type: 'custom',
				description: 'Throwing hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'throwingHook' }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(false);
			expect(result.message).toContain("Hook 'throwingHook' failed");
			expect(result.data?.error_id).toBeDefined();
		});

		it('should log error with correct context', async () => {
			const hookAction: Action = {
				name: 'errorHook',
				handler: async () => {
					throw new Error('Test error');
				},
				type: 'custom',
				description: 'Error hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'errorHook' }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				input: 'data',
			});

			expect(result.status).toBe(false);
			expect(result.data?.error_id).toBeDefined();
		});
	});

	describe('executeHook - Failure (canFail: true)', () => {
		it('should continue pipeline when hook fails with canFail: true', async () => {
			const hookAction: Action = {
				name: 'optionalHook',
				handler: async () => safeError('Optional failed', 'optional-error'),
				type: 'custom',
				description: 'Optional hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: vi.fn(async (data) => Ok({ ...data, processed: true })),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'optionalHook', canFail: true }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(true);
			expect(mainAction.handler).toHaveBeenCalled();
			expect(result.data).toEqual({ test: 'data', processed: true });
		});

		it('should pass through original input when canFail hook fails', async () => {
			const hookAction: Action = {
				name: 'transformFailHook',
				handler: async () => safeError('Transform failed', 'transform-error'),
				type: 'custom',
				description: 'Transform fail hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'transformFailHook', canFail: true }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const originalInput = { original: 'data' };
			const result = await executor.executeActionWithHooks(
				mainAction,
				originalInput
			);

			expect(result.status).toBe(true);
			expect(result.data).toEqual(originalInput);
		});

		it('should mark logEntry.passed = false but continue execution', async () => {
			const hookAction: Action = {
				name: 'failButContinue',
				handler: async () => safeError('Failed', 'error'),
				type: 'custom',
				description: 'Fail but continue',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'failButContinue', canFail: true }],
				},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(true);
			expect(result.data.pipeline.log.before[0].passed).toBe(false);
		});

		it('should handle thrown error with canFail: true', async () => {
			const hookAction: Action = {
				name: 'throwButContinue',
				handler: async () => {
					throw new Error('Thrown error');
				},
				type: 'custom',
				description: 'Throw but continue',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: vi.fn(async (data) => Ok(data)),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'throwButContinue', canFail: true }],
				},
			};

			const executor = createHookExecutor([hookAction, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(true);
			expect(mainAction.handler).toHaveBeenCalled();
		});
	});

	describe('executeHooks - Pipeline Chaining', () => {
		it('should chain hook outputs to next hook inputs', async () => {
			const hook1: Action = {
				name: 'addField1',
				handler: async (data) => Ok({ ...data, field1: 'value1' }),
				type: 'custom',
				description: 'Add field 1',
				validation: {},
				meta: {},
			};

			const hook2: Action = {
				name: 'addField2',
				handler: async (data) => Ok({ ...data, field2: 'value2' }),
				type: 'custom',
				description: 'Add field 2',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'addField1' }, { name: 'addField2' }],
				},
			};

			const executor = createHookExecutor([hook1, hook2, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				original: 'data',
			});

			expect(result.status).toBe(true);
			expect(result.data).toEqual({
				original: 'data',
				field1: 'value1',
				field2: 'value2',
			});
		});

		it('should execute empty hooks array without modification', async () => {
			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [],
				},
			};

			const executor = createHookExecutor([mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(true);
			expect(result.data).toEqual({ test: 'data' });
		});

		it('should stop pipeline at first failing hook (canFail: false)', async () => {
			const hook1: Action = {
				name: 'successHook',
				handler: async (data) => Ok({ ...data, success: true }),
				type: 'custom',
				description: 'Success hook',
				validation: {},
				meta: {},
			};

			const hook2: Action = {
				name: 'failHook',
				handler: async () => safeError('Failed', 'error'),
				type: 'custom',
				description: 'Fail hook',
				validation: {},
				meta: {},
			};

			const hook3: Action = {
				name: 'neverExecuted',
				handler: vi.fn(async (data) => Ok(data)),
				type: 'custom',
				description: 'Never executed',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: vi.fn(async (data) => Ok(data)),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [
						{ name: 'successHook' },
						{ name: 'failHook' },
						{ name: 'neverExecuted' },
					],
				},
			};

			const executor = createHookExecutor([hook1, hook2, hook3, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(false);
			expect(hook3.handler).not.toHaveBeenCalled();
			expect(mainAction.handler).not.toHaveBeenCalled();
		});

		it('should continue pipeline when hook fails with canFail: true', async () => {
			const hook1: Action = {
				name: 'hook1',
				handler: async (data) => Ok({ ...data, step1: true }),
				type: 'custom',
				description: 'Hook 1',
				validation: {},
				meta: {},
			};

			const hook2: Action = {
				name: 'optionalFail',
				handler: async () => safeError('Optional failed', 'error'),
				type: 'custom',
				description: 'Optional fail',
				validation: {},
				meta: {},
			};

			const hook3: Action = {
				name: 'hook3',
				handler: async (data) => Ok({ ...data, step3: true }),
				type: 'custom',
				description: 'Hook 3',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [
						{ name: 'hook1' },
						{ name: 'optionalFail', canFail: true },
						{ name: 'hook3' },
					],
				},
			};

			const executor = createHookExecutor([hook1, hook2, hook3, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				original: 'data',
			});

			expect(result.status).toBe(true);
			expect(result.data).toEqual({
				original: 'data',
				step1: true,
				step3: true,
			});
		});

		it('should add hooks to correct phase log (before vs after)', async () => {
			const beforeHook: Action = {
				name: 'beforeHook',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Before hook',
				validation: {},
				meta: {},
			};

			const afterHook: Action = {
				name: 'afterHook',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'After hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'beforeHook' }],
					after: [{ name: 'afterHook' }],
				},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([
				beforeHook,
				afterHook,
				mainAction,
			]);
			const result = await executor.executeActionWithHooks(mainAction, {
				test: 'data',
			});

			expect(result.status).toBe(true);
			expect(result.data.pipeline.log.before).toHaveLength(1);
			expect(result.data.pipeline.log.after).toHaveLength(1);
			expect(result.data.pipeline.log.before[0].name).toBe('beforeHook');
			expect(result.data.pipeline.log.after[0].name).toBe('afterHook');
		});
	});

	describe('executeHooks - State Sharing', () => {
		it('should share hookState across hooks in pipeline', async () => {
			const hook1: Action = {
				name: 'setStateHook',
				handler: async (data, context) => {
					context.hookState.userId = 'user123';
					context.hookState.timestamp = Date.now();
					return Ok(data);
				},
				type: 'custom',
				description: 'Set state hook',
				validation: {},
				meta: {},
			};

			let receivedState: any;
			const hook2: Action = {
				name: 'readStateHook',
				handler: async (data, context) => {
					receivedState = context.hookState;
					return Ok(data);
				},
				type: 'custom',
				description: 'Read state hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'setStateHook' }, { name: 'readStateHook' }],
				},
			};

			const executor = createHookExecutor([hook1, hook2, mainAction]);
			await executor.executeActionWithHooks(mainAction, { test: 'data' });

			expect(receivedState).toBeDefined();
			expect(receivedState.userId).toBe('user123');
			expect(receivedState.timestamp).toBeDefined();
		});

		it('should preserve state from before hooks to after hooks', async () => {
			const beforeHook: Action = {
				name: 'beforeStateHook',
				handler: async (data, context) => {
					context.hookState.beforeData = 'before-value';
					return Ok(data);
				},
				type: 'custom',
				description: 'Before state hook',
				validation: {},
				meta: {},
			};

			let afterState: any;
			const afterHook: Action = {
				name: 'afterStateHook',
				handler: async (data, context) => {
					afterState = context.hookState;
					return Ok(data);
				},
				type: 'custom',
				description: 'After state hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'beforeStateHook' }],
					after: [{ name: 'afterStateHook' }],
				},
			};

			const executor = createHookExecutor([
				beforeHook,
				afterHook,
				mainAction,
			]);
			await executor.executeActionWithHooks(mainAction, { test: 'data' });

			expect(afterState).toBeDefined();
			expect(afterState.beforeData).toBe('before-value');
		});

		it('should initialize empty state object', async () => {
			let receivedState: any;

			const hook: Action = {
				name: 'checkStateHook',
				handler: async (data, context) => {
					receivedState = context.hookState;
					return Ok(data);
				},
				type: 'custom',
				description: 'Check state hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'checkStateHook' }],
				},
			};

			const executor = createHookExecutor([hook, mainAction]);
			await executor.executeActionWithHooks(mainAction, { test: 'data' });

			expect(receivedState).toBeDefined();
			expect(receivedState).toEqual({});
		});
	});

	describe('executeActionWithHooks - Pipeline Flow', () => {
		it('should execute action without hooks', async () => {
			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok({ processed: true, ...data }),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
			};

			const executor = createHookExecutor([mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				input: 'data',
			});

			expect(result.status).toBe(true);
			expect(result.data).toEqual({ processed: true, input: 'data' });
		});

		it('should transform input via before hooks', async () => {
			const beforeHook: Action = {
				name: 'validateInput',
				handler: async (data) => Ok({ ...data, validated: true }),
				type: 'custom',
				description: 'Validate input',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: vi.fn(async (data) => Ok(data)),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'validateInput' }],
				},
			};

			const executor = createHookExecutor([beforeHook, mainAction]);
			await executor.executeActionWithHooks(mainAction, { original: 'data' });

			expect(mainAction.handler).toHaveBeenCalledWith(
				{ original: 'data', validated: true },
				expect.anything()
			);
		});

		it('should transform output via after hooks', async () => {
			const afterHook: Action = {
				name: 'enrichOutput',
				handler: async (data) => Ok({ ...data, enriched: true }),
				type: 'custom',
				description: 'Enrich output',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async () => Ok({ result: 'data' }),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					after: [{ name: 'enrichOutput' }],
				},
			};

			const executor = createHookExecutor([afterHook, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(true);
			expect(result.data).toEqual({ result: 'data', enriched: true });
		});

		it('should execute full pipeline: before → handler → after', async () => {
			const executionOrder: string[] = [];

			const beforeHook: Action = {
				name: 'beforeHook',
				handler: async (data) => {
					executionOrder.push('before');
					return Ok({ ...data, before: true });
				},
				type: 'custom',
				description: 'Before hook',
				validation: {},
				meta: {},
			};

			const afterHook: Action = {
				name: 'afterHook',
				handler: async (data) => {
					executionOrder.push('after');
					return Ok({ ...data, after: true });
				},
				type: 'custom',
				description: 'After hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => {
					executionOrder.push('handler');
					return Ok({ ...data, handler: true });
				},
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'beforeHook' }],
					after: [{ name: 'afterHook' }],
				},
			};

			const executor = createHookExecutor([
				beforeHook,
				afterHook,
				mainAction,
			]);
			const result = await executor.executeActionWithHooks(mainAction, {
				input: 'data',
			});

			expect(result.status).toBe(true);
			expect(executionOrder).toEqual(['before', 'handler', 'after']);
			expect(result.data).toEqual({
				input: 'data',
				before: true,
				handler: true,
				after: true,
			});
		});
	});

	describe('executeActionWithHooks - Result Format', () => {
		it('should return just result when pipeline not requested', async () => {
			const mainAction: Action = {
				name: 'mainAction',
				handler: async () => Ok({ data: 'result' }),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
			};

			const executor = createHookExecutor([mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(true);
			expect(result.data).toEqual({ data: 'result' });
			expect(result.data.pipeline).toBeUndefined();
		});

		it('should return result with pipeline when result.pipeline: true', async () => {
			const mainAction: Action = {
				name: 'mainAction',
				handler: async () => Ok({ data: 'result' }),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(true);
			expect(result.data.result).toEqual({ data: 'result' });
			expect(result.data.pipeline).toBeDefined();
			expect(result.data.pipeline.state).toEqual({});
			expect(result.data.pipeline.log).toEqual({ before: [], after: [] });
		});

		it('should include state in pipeline output', async () => {
			const hook: Action = {
				name: 'stateHook',
				handler: async (data, context) => {
					context.hookState.custom = 'value';
					return Ok(data);
				},
				type: 'custom',
				description: 'State hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'stateHook' }],
				},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([hook, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(true);
			expect(result.data.pipeline.state).toEqual({ custom: 'value' });
		});

		it('should include log entries in pipeline output', async () => {
			const hook: Action = {
				name: 'loggedHook',
				handler: async (data) => Ok({ ...data, logged: true }),
				type: 'custom',
				description: 'Logged hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'loggedHook' }],
				},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([hook, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {
				input: 'data',
			});

			expect(result.status).toBe(true);
			expect(result.data.pipeline.log.before).toHaveLength(1);
			expect(result.data.pipeline.log.before[0]).toEqual({
				name: 'loggedHook',
				input: { input: 'data' },
				output: { input: 'data', logged: true },
				passed: true,
			});
		});
	});

	describe('executeActionWithHooks - Error Handling', () => {
		it('should not execute handler when before hook fails', async () => {
			const beforeHook: Action = {
				name: 'failingBefore',
				handler: async () => safeError('Before failed', 'error'),
				type: 'custom',
				description: 'Failing before',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: vi.fn(async (data) => Ok(data)),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'failingBefore' }],
				},
			};

			const executor = createHookExecutor([beforeHook, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(false);
			expect(mainAction.handler).not.toHaveBeenCalled();
		});

		it('should not execute after hooks when handler fails', async () => {
			const afterHook: Action = {
				name: 'afterHook',
				handler: vi.fn(async (data) => Ok(data)),
				type: 'custom',
				description: 'After hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async () => safeError('Handler failed', 'error'),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					after: [{ name: 'afterHook' }],
				},
			};

			const executor = createHookExecutor([afterHook, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(false);
			expect(result.message).toBe('Handler failed');
			expect(afterHook.handler).not.toHaveBeenCalled();
		});

		it('should set hookContext.error when handler fails', async () => {
			const mainAction: Action = {
				name: 'mainAction',
				handler: async () => safeError('Failed', 'error-id'),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(false);
		});

		it('should return error when after hook fails', async () => {
			const afterHook: Action = {
				name: 'failingAfter',
				handler: async () => safeError('After failed', 'error'),
				type: 'custom',
				description: 'Failing after',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'mainAction',
				handler: async () => Ok({ result: 'data' }),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				hooks: {
					after: [{ name: 'failingAfter' }],
				},
			};

			const executor = createHookExecutor([afterHook, mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(false);
			expect(result.message).toBe('After failed');
		});

		it('should catch and log pipeline exceptions', async () => {
			const mainAction: Action = {
				name: 'mainAction',
				handler: async () => {
					throw new Error('Unexpected error');
				},
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
			};

			const executor = createHookExecutor([mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(false);
			expect(result.message).toContain("Action 'mainAction' pipeline failed");
			expect(result.data?.error_id).toBeDefined();
		});
	});

	describe('executeActionWithHooks - Context Management', () => {
		it('should create HookContext with correct structure', async () => {
			let receivedContext: any;

			const hook: Action = {
				name: 'contextHook',
				handler: async (data, context) => {
					receivedContext = context;
					return Ok(data);
				},
				type: 'custom',
				description: 'Context hook',
				validation: {},
				meta: {},
			};

			const mainAction: Action = {
				name: 'testAction',
				handler: async (data) => Ok(data),
				type: 'custom',
				description: 'Test action',
				validation: {},
				meta: {},
				hooks: {
					before: [{ name: 'contextHook' }],
				},
			};

			const executor = createHookExecutor([hook, mainAction]);
			await executor.executeActionWithHooks(mainAction, { input: 'data' });

			expect(receivedContext.hookState).toBeDefined();
		});

		it('should set hookContext.output after handler execution', async () => {
			const mainAction: Action = {
				name: 'mainAction',
				handler: async () => Ok({ result: 'success' }),
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
				result: {
					pipeline: true,
				},
			};

			const executor = createHookExecutor([mainAction]);
			const result = await executor.executeActionWithHooks(mainAction, {});

			expect(result.status).toBe(true);
			expect(result.data.result).toEqual({ result: 'success' });
		});

		it('should pass original context to handler if provided', async () => {
			let handlerContext: any;

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data, context) => {
					handlerContext = context;
					return Ok(data);
				},
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
			};

			const executor = createHookExecutor([mainAction]);
			await executor.executeActionWithHooks(mainAction, {}, { userId: 'user123' });

			expect(handlerContext.userId).toBe('user123');
		});

		it('should use hookContext when no original context provided', async () => {
			let handlerContext: any;

			const mainAction: Action = {
				name: 'mainAction',
				handler: async (data, context) => {
					handlerContext = context;
					return Ok(data);
				},
				type: 'custom',
				description: 'Main action',
				validation: {},
				meta: {},
			};

			const executor = createHookExecutor([mainAction]);
			await executor.executeActionWithHooks(mainAction, { input: 'data' });

			expect(handlerContext.actionName).toBe('mainAction');
			expect(handlerContext.input).toEqual({ input: 'data' });
			expect(handlerContext.state).toEqual({});
		});
	});
});
